{
  "name": "wordcloud",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:all": "pnpm run build && pnpm run api:lint && pnpm run api:build",
    "preview": "vite preview",
    "api:lint": "redocly lint openapi.yaml",
    "api:build": "node scripts/build-api-docs.mjs",
    "deploy": "wrangler deploy",
    "deploy:release": "node scripts/deploy.mjs",
    "deploy:github": "node scripts/deploy.mjs --github",
    "typecheck": "tsc -b --pretty false",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "test:ci": "vitest run --maxWorkers=1",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "test:integration": "vitest run tests/integration",
    "test:security": "vitest run tests/security",
    "test:stress": "vitest run tests/stress",
    "wrangler:dry-run": "wrangler deploy --dry-run",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv .wrangler/worker-configuration.generated.d.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.2.0",
    "brotli-wasm": "3.0.1",
    "fflate": "0.8.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@cloudflare/vite-plugin": "1.62.0",
    "@playwright/test": "1.63.0",
    "@redocly/cli": "2.54.3",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "swagger-ui-dist": "5.33.0",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2",
    "wrangler": "4.143.0"
  }
}
